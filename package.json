{
  "name": "emlak-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:stable",
    "dev:stable": "rm -rf .next && WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=80 next dev --hostname 127.0.0.1 --port 3000 --webpack",
    "dev:fresh": "npm run dev:stable",
    "dev:reset": "pkill -f \"next dev\" || true; rm -rf .next",
    "dev:doctor": "node -e \"console.log('cwd:', process.cwd());\" && git rev-parse --short HEAD && curl -s -I http://127.0.0.1:3000 | rg -n 'HTTP/|Cache-Control' || true",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "github-push": "node scripts/github-push.mjs",
    "test:slider": "node scripts/test-slider-hint.mjs",
    "test:stage-regression": "node scripts/stage-regression.mjs",
    "test:enhance-regression": "node scripts/enhance-regression.mjs",
    "test:stage-prompt-snapshots": "node --experimental-strip-types scripts/stage-prompt-snapshots.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "jimp": "^1.6.0",
    "next": "16.1.6",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pm2": "^6.0.14",
    "typescript": "^5"
  }
}
